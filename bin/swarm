#!/usr/bin/env bb
;; swarm — launch a SwarmForge-style role swarm on the herdr runtime.
;;
;; Usage (run from your project's root, inside a running `herdr` session):
;;   swarm init <pack>      copy a pack preset + prompts into the project
;;   swarm switch <pack>    change packs: replace conf + pack article, add
;;                          missing role prompts; project/toolset kept
;;   swarm toolset <name>   install a quality-toolset article
;;   swarm up               start worktrees, agents, and the handoff router
;;   swarm bootstrap [role] (re)send role prompts to running agents
;;   swarm prompt <role> <text>   send a task to a role by its short name
;;   swarm squad <cmd>      squad mode: up | spawn | retire | status |
;;                          approvals | approve | deny | report
;;   swarm logs [n]         interleaved timeline of all swarm activity
;;   swarm down             stop daemons and close the swarm workspace
;;   swarm retire           remove a fully integrated pack swarm
;;   swarm status           show swarm runtime state
;;
;; swarmforge.conf format (upstream-compatible):
;;   window <role> <agent-kind> <worktree> [task|batch] [extra-cli-args...]
;; A worktree of `master` or `none` means the role works in the project root.

(ns swarm
  (:require [babashka.fs :as fs]
            [babashka.process :as process]
            [cheshire.core :as json]
            [clojure.edn :as edn]
            [clojure.string :as str]))

(def tool-root (-> *file* fs/real-path fs/parent fs/parent))
(def scripts-src (fs/path tool-root "swarmforge" "scripts"))
(def project-root (fs/cwd))
(def state-dir (fs/path project-root ".swarmforge"))
(def conf-file (fs/path project-root "swarmforge" "swarmforge.conf"))
(def worktrees-dir (fs/path project-root ".worktrees"))
(def receive-modes #{"task" "batch"})
(def protected-branches #{"main" "master"})
(def project-root-worktrees #{"master" "none"})

(defn slog!
  "Append a timestamped line to the swarm's own log so launcher actions
  survive terminal scrollback."
  [& parts]
  (try
    (fs/create-dirs state-dir)
    (spit (str (fs/path state-dir "swarm.log"))
          (str (java.time.Instant/now) " " (str/join " " parts) "\n")
          :append true)
    (catch Exception _ nil)))

(defn die [& lines]
  (binding [*out* *err*]
    (doseq [line lines :when line] (println line)))
  (System/exit 1))

(defn sh-ok [& args]
  (let [{:keys [exit err out]} (apply process/sh {:continue true} args)]
    (when-not (zero? exit)
      (die (str "Command failed: " (str/join " " args))
           (str/trim (str out "\n" err))))
    out))

(defn project-agent-name
  "Global herdr agent name for a role or worker in this project: project
  prefix + lowercased suffix, herdr-safe, left-trimmed to 32 chars so the
  distinctive tail survives."
  [suffix]
  (let [prefix (-> (str (fs/file-name project-root))
                   str/lower-case
                   (str/replace #"[^a-z0-9_-]" "-")
                   (as-> p (if (re-find #"^[a-z]" p) p (str "p" p))))
        n (-> (str prefix "-" (str/lower-case suffix))
              (str/replace #"[^a-z0-9_-]" "-"))
        n (if (> (count n) 32) (subs n (- (count n) 32)) n)]
    (if (re-find #"^[a-z]" n) n (str "w" (subs n 1)))))

;; --- configuration --------------------------------------------------------

(defn parse-conf []
  (when-not (fs/exists? conf-file)
    (die (str "No " conf-file)
         "Run `swarm init <pack>` first (packs: two, four, six, adversaries)."))
  (let [rows
        (for [[line-no line] (map-indexed vector (str/split-lines (slurp (str conf-file))))
              :let [trimmed (str/trim line)]
              :when (and (not (str/blank? trimmed))
                         (not (str/starts-with? trimmed "#")))]
          (let [fields (str/split trimmed #"\s+")
                [keyword role agent-kind worktree & trailing] fields
                [mode extra] (if (receive-modes (first trailing))
                               [(first trailing) (rest trailing)]
                               ["task" trailing])]
            (when-not (= "window" keyword)
              (die (format "swarmforge.conf line %d: expected `window ...`, got `%s`"
                           (inc line-no) trimmed)))
            (when (or (nil? worktree) (str/blank? role))
              (die (format "swarmforge.conf line %d: window needs <role> <agent> <worktree>"
                           (inc line-no))))
            (when (str/includes? role "_")
              (die (format "Invalid role '%s': role names may not contain underscores." role)))
            (when (or (str/includes? worktree "/") (#{"." ".."} worktree))
              (die (format "Invalid worktree '%s' for role '%s'." worktree role)))
            ;; Role names are protocol identifiers (upstream allows e.g. "QA");
            ;; herdr agent names must be lowercase AND are global across all
            ;; workspaces, so they get a project prefix — otherwise two swarms
            ;; sharing role names adopt each other's agents.
            (let [agent-name (project-agent-name role)]
              (when-not (re-matches #"[a-z][a-z0-9_-]{0,31}" agent-name)
                (die (format "Role '%s' cannot be mapped to a herdr agent name (got '%s')." role agent-name)))
              {:role role
               :agent-name agent-name
               :agent-kind agent-kind
               :worktree-name worktree
               :worktree-path (if (project-root-worktrees worktree)
                                (str project-root)
                                (str (fs/path worktrees-dir worktree)))
               :receive-mode mode
               :extra-args (vec extra)})))]
    (doseq [[value rows'] [[:role rows] [:agent-name rows]
                           [:worktree-name (remove #(project-root-worktrees (:worktree-name %)) rows)]]
            [duplicate n] (frequencies (map value rows'))
            :when (> n 1)]
      (die (format "Duplicate %s '%s' in swarmforge.conf" (name value) duplicate)))
    (vec rows)))

;; --- project preparation --------------------------------------------------

(defn ensure-gitignore! []
  (let [gitignore (fs/path project-root ".gitignore")
        existing (if (fs/exists? gitignore) (slurp (str gitignore)) "")]
    (doseq [entry [".swarmforge/" ".worktrees/"]]
      (when-not (some #(= entry (str/trim %)) (str/split-lines existing))
        (spit (str gitignore) (str entry "\n") :append true)))))

(defn ensure-worktrees! [rows]
  (doseq [{:keys [worktree-name worktree-path]} rows
          :when (not (project-root-worktrees worktree-name))
          :when (not (fs/exists? (fs/path worktree-path ".git")))]
    (println "Creating worktree" worktree-path)
    (sh-ok "git" "-C" (str project-root) "worktree" "add" "--force"
           "-B" (str "swarmforge-" worktree-name) worktree-path "HEAD")))

(defn ensure-coder-is-off-protected-branch! [rows]
  (let [has-root-coder? (some #(and (= "coder" (str/lower-case (:role %)))
                                    (project-root-worktrees (:worktree-name %)))
                              rows)
        branch (when has-root-coder?
                 (str/trim (sh-ok "git" "-C" (str project-root)
                                  "branch" "--show-current")))]
    (when (protected-branches branch)
      (die (str "Refusing to start coder in the project root on protected branch '"
                branch "'.")
           "Use an isolated coder worktree, such as the adversaries-codex-review pack,"
           "or switch the project root to a review/<task> branch first."))))

(defn sync-scripts! [rows]
  (doseq [path (distinct (map :worktree-path rows))
          :let [target (fs/path path "swarmforge" "scripts")]
          :when (not= (str target) (str scripts-src))]
    (fs/create-dirs target)
    (doseq [script (fs/list-dir scripts-src)]
      (fs/copy script (fs/path target (fs/file-name script))
               {:replace-existing true :copy-attributes true}))))

(defn write-roles-tsv! [rows]
  (fs/create-dirs state-dir)
  (spit (str (fs/path state-dir "roles.tsv"))
        (str/join "" (for [{:keys [role agent-name worktree-name worktree-path agent-kind receive-mode]} rows]
                       (str (str/join "\t" [role worktree-name worktree-path
                                            agent-name role agent-kind receive-mode])
                            "\n")))))

(defn ensure-queue-dirs! [rows]
  (doseq [path (distinct (map :worktree-path rows))
          sub [["outbox" "tmp"] ["sent"] ["failed"]
               ["inbox" "new"] ["inbox" "in_process"] ["inbox" "completed"]]]
    (fs/create-dirs (apply fs/path path ".swarmforge" "handoffs" sub))))

;; --- herdr ----------------------------------------------------------------

(defn herdr-try
  "Run a herdr subcommand without dying. Returns {:ok? :data :error-code
  :error-message}; :data is parsed JSON when the output is JSON."
  [& args]
  (let [{:keys [exit out err]} (apply process/sh {:continue true} "herdr" args)
        parse-json (fn [s]
                     (let [trimmed (str/trim (str s))]
                       (when (or (str/starts-with? trimmed "{") (str/starts-with? trimmed "["))
                         (try (json/parse-string trimmed true) (catch Exception _ nil)))))
        ;; herdr writes results to stdout but error JSON to stderr
        parsed (or (parse-json out) (parse-json err))]
    {:ok? (zero? exit)
     :data (or parsed (str/trim (str out)))
     :error-code (get-in parsed [:error :code])
     :error-message (or (get-in parsed [:error :message])
                        (str/trim (str out "\n" err)))}))

(defn herdr
  "Run a herdr subcommand or die with its actual error."
  [& args]
  (let [{:keys [ok? data error-message]} (apply herdr-try args)]
    (when-not ok?
      (die (str "herdr " (str/join " " args) " failed:")
           error-message
           (when (re-find #"(?i)connect|refused|socket|not running|no such file" error-message)
             "Is the herdr server running? Start it with `herdr` (or `herdr server`).")))
    data))

(defn find-id
  "Defensively extract an id from herdr JSON: prefer keys containing `hint`
  and ending in id, then a bare :id, searching depth-first."
  [data hint]
  (letfn [(search [node pred]
            (cond
              (map? node) (or (some (fn [[k v]] (when (and (pred (name k)) (string? v)) v))
                                    node)
                              (some #(search % pred) (vals node)))
              (sequential? node) (some #(search % pred) node)))]
    (or (search data #(and (str/includes? (str/lower-case %) hint)
                           (str/ends-with? (str/lower-case %) "id")))
        (search data #(= "id" (str/lower-case %)))
        (die (str "Could not find a " hint " id in herdr output:")
             (json/generate-string data)))))

(defn bootstrap-prompt [role worktree-path]
  (let [role-prompt (fs/path project-root "swarmforge" "roles" (str role ".prompt"))
        constitution (fs/path project-root "swarmforge" "constitution.prompt")]
    (str "You are the '" role "' role in a SwarmForge-style swarm. "
         "Your registered worktree is " worktree-path " — do ALL work there, "
         "even if other role worktrees exist on disk. "
         (if (fs/exists? constitution)
           (str "Read swarmforge/constitution.prompt"
                (when (fs/exists? role-prompt)
                  (str " and swarmforge/roles/" role ".prompt"))
                " and follow them exactly. ")
           "Work only in this directory; hand completed work to other roles as commits. ")
         "When you receive a handoff wake-up (or right now, and after every "
         "completed task), run swarmforge/scripts/ready_for_next.sh and follow "
         "its output. Send handoffs only through swarmforge/scripts/swarm_handoff.sh. "
         "When your current task is fully complete, run "
         "swarmforge/scripts/done_with_current.sh.")))

(defn existing-workspace
  "The workspace recorded by a previous `swarm up`, if herdr still has it."
  []
  (let [ws-file (fs/path state-dir "herdr-workspace")]
    (when (fs/exists? ws-file)
      (let [id (str/trim (slurp (str ws-file)))]
        (when (:ok? (herdr-try "workspace" "get" id))
          id)))))

(defn existing-agents []
  (let [{:keys [ok? data]} (herdr-try "agent" "list")]
    (if ok?
      (set (keep #(or (:name %) (:label %))
                 (get-in data [:result :agents])))
      #{})))

(defn launch-agents!
  "Start each role's agent; reuses a previous workspace and skips roles
  already running. Returns roles needing human attention (blocked during
  startup — usually a first-run dialog in their pane)."
  [rows]
  (let [workspace-id (or (existing-workspace)
                         (let [ws (herdr "workspace" "create"
                                         "--cwd" (str project-root)
                                         "--label" (str "swarm:" (fs/file-name project-root))
                                         "--no-focus")
                               id (find-id ws "workspace")]
                           (spit (str (fs/path state-dir "herdr-workspace")) (str id "\n"))
                           id))
        running (existing-agents)
        needs-attention (atom [])]
    (doseq [{:keys [role agent-name agent-kind worktree-path extra-args]} rows]
      (if (running agent-name)
        (do (slog! "up:" role "already running")
            (println role "already running."))
        (let [_ (println "Starting" role (str "(" agent-kind ")") "in" worktree-path)
              tab (herdr "tab" "create"
                         "--workspace" workspace-id
                         "--cwd" worktree-path
                         "--label" role
                         "--env" (str "SWARMFORGE_ROLE=" role)
                         "--no-focus")
              pane-id (find-id tab "pane")
              ;; A fresh tab's shell may not be ready yet (herdr reports
              ;; "not an available shell"); retry briefly before giving up.
              start (loop [attempt 1]
                      (let [res (apply herdr-try "agent" "start" agent-name "--kind" agent-kind "--pane" pane-id
                                       (when (seq extra-args) (cons "--" extra-args)))]
                        (if (and (not (:ok? res))
                                 (str/includes? (str (:error-message res)) "not an available shell")
                                 (< attempt 15))
                          (do (Thread/sleep 2000) (recur (inc attempt)))
                          res)))]
          (cond
            (:ok? start)
            (let [prompted (herdr-try "agent" "prompt" agent-name (bootstrap-prompt role worktree-path))]
              (slog! "up: started" role "as" agent-name "in pane" pane-id)
              (when-not (:ok? prompted)
                (slog! "up: bootstrap prompt failed for" role)
                (swap! needs-attention conj role)))

            (= "agent_not_ready" (:error-code start))
            (do (println "  " role "started but is BLOCKED (a startup dialog in its pane).")
                (slog! "up:" role "blocked at startup, needs attention")
                (swap! needs-attention conj role))

            :else
            (do (slog! "up: agent start FAILED for" role "-" (:error-message start))
                (die (str "herdr agent start " role " failed:") (:error-message start)))))))
    @needs-attention))

;; --- daemon lifecycle -----------------------------------------------------
;; Both daemons share one convention: <dir>/<name>.{pid,log} plus a stop
;; file. handoffd routes handoffs; squadd (S3) applies the squad advisor's
;; mechanical actions, and is started with SWARM_BIN pointing back at this
;; launcher so its spawn/retire shell-outs run the same binary.

(def handoffd-daemon
  {:name "handoffd" :dir (fs/path state-dir "daemon")})

(def squadd-daemon
  {:name "squadd" :dir (fs/path state-dir "squad" "daemon")
   :env {"SWARM_BIN" (str (fs/path tool-root "bin" "swarm"))}})

(defn daemon-pid [{:keys [dir name]}]
  (let [pid-file (fs/path dir (str name ".pid"))]
    (when (fs/exists? pid-file)
      (parse-long (str/trim (slurp (str pid-file)))))))

(defn daemon-running? [daemon]
  (when-let [pid (daemon-pid daemon)]
    (some-> (java.lang.ProcessHandle/of pid) (.orElse nil) (.isAlive))))

(defn start-daemon! [{:keys [name dir env] :as daemon}]
  (if (daemon-running? daemon)
    (println name "already running, pid" (daemon-pid daemon))
    (do
      (fs/create-dirs dir)
      (fs/delete-if-exists (fs/path dir "stop"))
      (let [log (fs/file (fs/path dir (str name ".log")))
            proc (process/process
                  ["bb" (str (fs/path scripts-src (str name ".bb"))) (str project-root)]
                  (cond-> {:out :append :out-file log :err :append :err-file log}
                    env (assoc :extra-env env)))]
        (slog! "up:" name "started, pid" (.pid (:proc proc)))
        (println name "started, pid" (.pid (:proc proc)))))))

(defn stop-daemon! [{:keys [name dir] :as daemon}]
  (fs/create-dirs dir)
  (spit (str (fs/path dir "stop")) "")
  (when-let [pid (daemon-pid daemon)]
    (some-> (java.lang.ProcessHandle/of pid) (.orElse nil) (.destroy)))
  (println name "stop requested."))

;; --- subcommands ----------------------------------------------------------

(defn- install! [source target]
  (when-not (fs/exists? target)
    (fs/create-dirs (fs/parent target))
    (fs/copy source target)
    (println "Wrote" (str target))))

(defn- install-role-prompts! [rows]
  (let [prompts (fs/path tool-root "prompts")
        target (fs/path project-root "swarmforge")]
    (doseq [{:keys [role]} rows]
      (let [prompt (fs/path prompts "roles" (str role ".prompt"))
            contract (fs/path prompts "contracts" (str role ".contract.edn"))]
        (if (fs/exists? prompt)
          (install! prompt (fs/path target "roles" (str role ".prompt")))
          (println "NOTE: no stock prompt for role" role "— write"
                   (str target "/roles/" role ".prompt")))
        (when (fs/exists? contract)
          (install! contract (fs/path target "contracts" (str role ".contract.edn"))))))))

(defn init! [pack]
  (let [source (fs/path tool-root "packs" (str pack ".conf"))
        prompts (fs/path tool-root "prompts")
        target (fs/path project-root "swarmforge")]
    (when-not (and pack (fs/exists? source))
      (die (str "Unknown pack: " pack)
           (str "Available: " (str/join ", " (sort (keep #(second (re-matches #"(.+)\.conf" (fs/file-name %)))
                                                         (fs/list-dir (fs/path tool-root "packs"))))))))
    (when (fs/exists? conf-file)
      (die (str conf-file " already exists; edit it or remove it first.")))
    (install! source conf-file)
    (install! (fs/path prompts "constitution.prompt") (fs/path target "constitution.prompt"))
    (doseq [article (fs/list-dir (fs/path prompts "articles"))]
      (install! article (fs/path target "constitution" "articles" (fs/file-name article))))
    (install! (fs/path tool-root "packs" (str pack ".prompt"))
              (fs/path target "constitution" "articles" "pack.prompt"))
    (install-role-prompts! (parse-conf))
    (println)
    (println "Next: edit swarmforge/constitution/articles/project.prompt for this project,")
    (println "review the agent kinds in swarmforge/swarmforge.conf,")
    (println "then run `swarm up` from a running herdr session.")))

(defn switch! [pack]
  (let [source (fs/path tool-root "packs" (str pack ".conf"))]
    (when-not (and pack (fs/exists? source))
      (die (str "Unknown pack: " pack)))
    (when-not (fs/exists? conf-file)
      (die "No swarm here yet — use `swarm init <pack>` instead."))
    (fs/copy source conf-file {:replace-existing true})
    (println "Replaced" (str conf-file))
    (fs/copy (fs/path tool-root "packs" (str pack ".prompt"))
             (fs/path project-root "swarmforge" "constitution" "articles" "pack.prompt")
             {:replace-existing true})
    (println "Replaced pack article.")
    (let [rows (parse-conf)
          active (set (map :worktree-name rows))
          stale (when (fs/exists? worktrees-dir)
                  (remove #(active (fs/file-name %)) (fs/list-dir worktrees-dir)))]
      (install-role-prompts! rows)
      (when (seq stale)
        (println)
        (println "NOTE: stale worktrees from a previous pack (agents will be told to")
        (println "ignore them; remove with `git worktree remove <path>` if unwanted):")
        (doseq [path stale] (println "  " (str path)))))
    (println)
    (println "Switched to" (str pack ".") "Project and toolset articles kept.")
    (println "Run `swarm up` — agents for roles that survive the switch are reused.")))

(defn toolset! [name]
  (let [source (fs/path tool-root "toolsets" (str name ".edn"))]
    (when-not (and name (fs/exists? source))
      (die (str "Unknown toolset: " name)
           (str "Available: " (str/join ", " (sort (keep #(second (re-matches #"(.+)\.edn" (fs/file-name %)))
                                                         (fs/list-dir (fs/path tool-root "toolsets"))))))))
    (let [{:keys [description purposes doctor]} (edn/read-string (slurp (str source)))
          article (fs/path project-root "swarmforge" "constitution" "articles" "toolset.prompt")]
      (fs/create-dirs (fs/parent article))
      (spit (str article)
            (str "# Article: Toolset (" name ")\n\n"
                 description "\n\n"
                 "These are the project's quality tools. Where a role prompt names a\n"
                 "purpose (coverage, mutation, crap, dry, boundaries, acceptance), use\n"
                 "exactly the command below — no substitutes.\n\n"
                 (str/join "\n"
                           (for [[purpose {:keys [command notes]}] (sort-by key purposes)]
                             (str "## " (clojure.core/name purpose) "\n\n"
                                  "    " command "\n"
                                  (when notes (str "\n" notes "\n")))))))
      (println "Wrote" (str article))
      (println)
      (println "Doctor:")
      (doseq [[cmd :as check] doctor]
        (let [{:keys [exit]} (try (apply process/sh {:continue true} check)
                                  (catch Exception _ {:exit 127}))]
          (println (format "  %-9s %s" (if (zero? exit) "ok" "MISSING") (str/join " " check)))
          (when-not (zero? exit)
            (when-let [install (some #(when (str/includes? (str (:install %)) cmd) (:install %))
                                     (vals purposes))]
              (println "           install:" install))))))))

(defn up! []
  (when-not (fs/exists? (fs/path project-root ".git"))
    (die "Run swarm from the root of a git repository."))
  (let [rows (parse-conf)]
    (ensure-coder-is-off-protected-branch! rows)
    (ensure-gitignore!)
    (ensure-worktrees! rows)
    (ensure-queue-dirs! rows)
    (sync-scripts! rows)
    (write-roles-tsv! rows)
    (let [needs-attention (launch-agents! rows)]
      (start-daemon! handoffd-daemon)
      (println)
      (println "Swarm is up:" (str/join ", " (map :role rows)))
      (when (seq needs-attention)
        (println)
        (println "NEEDS ATTENTION:" (str/join ", " needs-attention))
        (println "Open each blocked agent's pane, answer its startup dialog")
        (println "(e.g. Claude Code's folder-trust prompt), then run:")
        (doseq [role needs-attention]
          (println "  swarm bootstrap" role)))
      (println "Watch it in herdr; stop it with `swarm down`."))))

(defn bootstrap! [role-arg]
  (let [rows (parse-conf)
        targets (if role-arg
                  (filter #(or (= role-arg (:role %)) (= role-arg (:agent-name %))) rows)
                  rows)]
    (when (empty? targets)
      (die (str "Unknown role: " role-arg)))
    (doseq [{:keys [role agent-name worktree-path]} targets]
      (herdr "agent" "prompt" agent-name (bootstrap-prompt role worktree-path))
      (println "Sent role bootstrap to" role))))

(defn down! []
  (slog! "down: requested")
  (stop-daemon! handoffd-daemon)
  (stop-daemon! squadd-daemon)
  (let [ws-file (fs/path state-dir "herdr-workspace")]
    (if (fs/exists? ws-file)
      (let [workspace-id (str/trim (slurp (str ws-file)))]
        (herdr "workspace" "close" workspace-id)
        (fs/delete ws-file)
        (println "Closed herdr workspace" workspace-id))
      (println "No recorded herdr workspace; close it in herdr if one is open."))))

(defn- git-result [& args]
  (apply process/sh {:continue true} "git" "-C" (str project-root) args))

(defn- git-success? [& args]
  (zero? (:exit (apply git-result args))))

(defn- git-output [& args]
  (let [{:keys [exit out err]} (apply git-result args)]
    (when-not (zero? exit)
      (die (str "Command failed: git -C " project-root " " (str/join " " args))
           (str/trim (str out "\n" err))))
    (str/trim out)))

(defn- expected-role-branch [{:keys [worktree-name]}]
  (str "swarmforge-" worktree-name))

(defn- registered-worktree-paths []
  (->> (str/split-lines (git-output "worktree" "list" "--porcelain"))
       (keep #(when (str/starts-with? % "worktree ")
                (subs % (count "worktree "))))
       set))

(defn- runtime-pack-blockers [rows]
  (let [roles-file (fs/path state-dir "roles.tsv")
        actual (when (fs/exists? roles-file)
                 (vec (for [line (str/split-lines (slurp (str roles-file)))
                            :when (not (str/blank? line))
                            :let [[role worktree-name path] (str/split line #"\t" -1)]]
                        [role worktree-name path])))
        expected (set (map (juxt :role :worktree-name :worktree-path) rows))]
    (cond
      (empty? actual) []
      (some #(= "squad-leader" (first %)) actual)
      ["squad runtime state is active; retire squad workers through `swarm squad retire`"]
      (not= expected (set actual))
      ["runtime roles.tsv does not match swarmforge.conf; refusing to guess which pack to remove"]
      :else [])))

(defn- files-under [root]
  (let [found (atom [])]
    (when (fs/exists? root)
      (fs/walk-file-tree
       root
       {:visit-file (fn [file _attrs]
                      (swap! found conj file)
                      :continue)}))
    @found))

(defn- queue-blockers [{:keys [role worktree-path]}]
  (let [handoffs (fs/path worktree-path ".swarmforge" "handoffs")
        watched [["outbound" ["outbox"]]
                 ["failed" ["failed"]]
                 ["new inbox" ["inbox" "new"]]
                 ["in-process inbox" ["inbox" "in_process"]]]]
    (vec
     (for [[label parts] watched
           :let [dir (apply fs/path handoffs parts)]
           file (files-under dir)]
       (str "role " role " has " label " handoff state: "
            (fs/relativize worktree-path file))))))

(defn- allowed-generated-status? [line]
  (boolean (re-matches #"\?\? swarmforge/scripts/?" line)))

(defn- worktree-status-blockers [{:keys [role worktree-path]}]
  (let [{:keys [exit out err]}
        (process/sh {:continue true} "git" "-C" worktree-path
                    "status" "--porcelain=v1" "--untracked-files=normal")]
    (if (zero? exit)
      (vec (for [line (str/split-lines out)
                 :when (not (str/blank? line))
                 :when (not (allowed-generated-status? line))]
             (str "role " role " has worktree changes: " line)))
      [(str "role " role " status failed: " (str/trim (str out "\n" err)))])))

(defn- direct-role-worktree? [{:keys [worktree-name worktree-path]}]
  (and (= (str (fs/normalize (fs/absolutize worktree-path)))
          (str (fs/normalize (fs/absolutize (fs/path worktrees-dir worktree-name)))))
       (try
         (= (str (fs/parent (fs/real-path worktree-path)))
            (str (fs/real-path worktrees-dir)))
         (catch Exception _ false))))

(defn- role-retire-blockers [target row registered]
  (let [{:keys [role worktree-path]} row
        branch (expected-role-branch row)
        path-exists? (fs/exists? worktree-path)
        marker-exists? (fs/exists? (fs/path worktree-path ".git"))
        branch-exists? (git-success? "show-ref" "--verify" "--quiet"
                                     (str "refs/heads/" branch))]
    (vec
     (concat
      (when (and path-exists? (not (direct-role-worktree? row)))
        [(str "role " role " path is not a direct child of .worktrees: " worktree-path)])
      (when (and path-exists? (not marker-exists?))
        [(str "role " role " path exists but is not a Git worktree: " worktree-path)])
      (when (and marker-exists? (not (contains? registered worktree-path)))
        [(str "role " role " path is not registered with Git: " worktree-path)])
      (when (and marker-exists?
                 (not= branch (str/trim
                               (:out (process/sh {:continue true}
                                                 "git" "-C" worktree-path
                                                 "branch" "--show-current")))))
        [(str "role " role " is not on its expected branch " branch)])
      (when marker-exists? (worktree-status-blockers row))
      (when marker-exists? (queue-blockers row))
      (when (and path-exists? (not branch-exists?))
        [(str "role " role " worktree exists but branch " branch " does not")])
      (when (and branch-exists?
                 (not (git-success? "merge-base" "--is-ancestor" branch target)))
        [(str "role " role " branch " branch " is not merged into " target)])))))

(defn- retire-blockers [target rows]
  (let [linked (remove #(project-root-worktrees (:worktree-name %)) rows)
        project-root-roles (filter #(project-root-worktrees (:worktree-name %)) rows)
        registered (registered-worktree-paths)]
    (vec (concat (runtime-pack-blockers rows)
                 (mapcat queue-blockers project-root-roles)
                 (mapcat #(role-retire-blockers target % registered) linked)))))

(defn- require-retire-ready! [target rows]
  (let [blockers (retire-blockers target rows)]
    (when (seq blockers)
      (slog! "retire: blocked into" target)
      (apply die
             (str "Cannot retire pack swarm into '" target "':")
             (concat (map #(str "- " %) blockers)
                     ["No role worktree or branch was removed."])))))

(defn- wait-for-daemons-to-stop! []
  (loop [attempt 0]
    (let [running (filter daemon-running? [handoffd-daemon squadd-daemon])]
      (cond
        (empty? running) nil
        (< attempt 50) (do (Thread/sleep 100) (recur (inc attempt)))
        :else (die (str "Daemons did not stop: "
                        (str/join ", " (map :name running)))
                   "No role worktree or branch was removed.")))))

(defn- require-role-agents-stopped! [rows]
  (let [{:keys [ok? data error-message]} (herdr-try "agent" "list")]
    (when-not ok?
      (die "Cannot verify that configured role agents stopped after shutdown:"
           error-message
           "Start Herdr, close the swarm workspace, and retry."
           "No role worktree or branch was removed."))
    (let [running (set (keep #(or (:name %) (:label %))
                             (get-in data [:result :agents])))
          active (vec (filter running (map :agent-name rows)))]
      (when (seq active)
        (apply die
               "Configured role agents are still registered after shutdown:"
               (concat (map #(str "- " %) active)
                       ["Close their Herdr workspace before retiring."
                        "No role worktree or branch was removed."]))))))

(defn retire! []
  (when-not (fs/exists? (fs/path project-root ".git"))
    (die "Run swarm from the root of a Git repository."))
  (let [rows (parse-conf)
        linked (vec (remove #(project-root-worktrees (:worktree-name %)) rows))
        target (git-output "branch" "--show-current")]
    (when (str/blank? target)
      (die "Cannot retire a pack from a detached HEAD."
           "Check out the integrated target branch first."))
    ;; Check once while the swarm is untouched, then again after shutdown so
    ;; an agent or router cannot race the destructive phase.
    (require-retire-ready! target rows)
    (slog! "retire: requested into" target)
    (down!)
    (wait-for-daemons-to-stop!)
    (require-role-agents-stopped! rows)
    (require-retire-ready! target rows)
    (let [worktrees (vec (filter #(fs/exists? (:worktree-path %)) linked))
          branches (vec (filter #(git-success? "show-ref" "--verify" "--quiet"
                                              (str "refs/heads/" (expected-role-branch %)))
                                linked))]
      (doseq [{:keys [worktree-path]} worktrees]
        (sh-ok "git" "-C" (str project-root) "worktree" "remove" "--force" worktree-path))
      (sh-ok "git" "-C" (str project-root) "worktree" "prune")
      (doseq [row branches]
        (sh-ok "git" "-C" (str project-root) "branch" "-d" (expected-role-branch row)))
      (fs/delete-if-exists (fs/path state-dir "roles.tsv"))
      (slog! "retire: completed into" target
             (str "worktrees=" (count worktrees))
             (str "branches=" (count branches)))
      (println (str "Retired pack swarm into " target "."))
      (println "Removed" (count worktrees) "role worktrees and"
               (count branches) "merged role branches.")
      (println "Preserved launcher logs and provider session histories.")
      (println "The next `swarm up` will recreate linked roles from current HEAD."))))

(defn- handoff-file-events
  "Timeline events from one handoff file's lifecycle headers. Sender-side
  copies (outbox/sent/failed) report creation; recipient-side copies
  (inbox/**) report enqueue/accept/complete, so nothing double-counts."
  [file]
  (let [[header] (str/split (slurp (str file)) #"\n\n" 2)
        h (into {} (keep #(let [[k v] (str/split % #": " 2)] (when v [k v]))
                         (str/split-lines header)))
        id (get h "id" (fs/file-name file))
        recipient-copy? (str/includes? (str file) "/inbox/")]
    (if recipient-copy?
      (keep (fn [[field label]]
              (when-let [t (get h field)]
                [t (str label " " id " (" (get h "recipient") ")")]))
            [["enqueued_at" "enqueued"] ["dequeued_at" "accepted"] ["completed_at" "completed"]])
      (when-let [t (get h "created_at")]
        [[t (str "created " id ": " (get h "from") " -> " (get h "to")
                 (when-let [task (get h "task")] (str " task=" task))
                 (when (str/includes? (str file) "/failed/") "  [FAILED]"))]]))))

(defn logs!
  "Interleave the launcher log, router log, and every handoff's lifecycle
  headers into one timeline (last N events, default 40)."
  [n-arg]
  (let [n (or (some-> n-arg parse-long) 40)
        tagged-lines (fn [path tag]
                       (for [line (if (fs/exists? path)
                                    (remove str/blank? (str/split-lines (slurp (str path))))
                                    [])
                             :let [[t & rest] (str/split line #" ")]]
                         [t (str tag " " (str/join " " rest))]))
        worktrees (if (fs/exists? (fs/path state-dir "roles.tsv"))
                    (distinct (for [line (str/split-lines (slurp (str (fs/path state-dir "roles.tsv"))))
                                    :when (not (str/blank? line))]
                                (nth (str/split line #"\t" -1) 2)))
                    [(str project-root)])
        queue-events (for [wt worktrees
                           :let [root (fs/path wt ".swarmforge" "handoffs")]
                           :when (fs/exists? root)
                           file (fs/glob root "**.handoff")
                           event (handoff-file-events file)]
                       [(first event) (str "[queue]  " (second event))])
        events (sort-by first
                        (concat (tagged-lines (fs/path state-dir "swarm.log") "[swarm] ")
                                (tagged-lines (fs/path state-dir "daemon" "handoffd.log") "[router]")
                                (tagged-lines (fs/path state-dir "squad" "daemon" "squadd.log") "[squadd]")
                                (tagged-lines (fs/path state-dir "squad" "events.log") "[squad] ")
                                queue-events))]
    (doseq [[t message] (take-last n events)]
      (println t message))))

(defn prompt! [role-arg text]
  (when (or (str/blank? role-arg) (str/blank? text))
    (die "Usage: swarm prompt <role> <text>"))
  (let [row (or (some #(when (or (= role-arg (:role %)) (= role-arg (:agent-name %))) %)
                      (parse-conf))
                (die (str "Unknown role: " role-arg)))]
    (herdr "agent" "prompt" (:agent-name row) text)
    (println "Prompted" (:role row) "(" (:agent-name row) ")")))

(defn status! []
  (println "project:" (str project-root))
  (println "conf:   " (if (fs/exists? conf-file) (str conf-file) "MISSING (run `swarm init <pack>`)"))
  (doseq [daemon [handoffd-daemon squadd-daemon]]
    (println (format "%-9s" (str (:name daemon) ":"))
             (if (daemon-running? daemon)
               (str "running, pid " (daemon-pid daemon))
               "not running")))
  (when (fs/exists? (fs/path state-dir "roles.tsv"))
    (doseq [line (str/split-lines (slurp (str (fs/path state-dir "roles.tsv"))))
            :let [[role _ path _ _ kind mode] (str/split line #"\t" -1)]]
      (println (format "role:    %-12s %-8s %-5s %s" role kind mode path)))))

;; --- squad (v2, S2): persistent leader + transient workers ----------------

(defn- squad-script
  "Run a squad state script from the project root; die on failure,
  return its stdout."
  [script & args]
  (let [{:keys [exit out err]} (apply process/sh {:continue true :dir (str project-root)}
                                     "bb" (str (fs/path scripts-src (str script ".bb"))) args)]
    (when-not (zero? exit)
      (die (str script " " (str/join " " args) " failed:") (str/trim (str out "\n" err))))
    (str out)))

(defn- script-token
  "Extract '<TOKEN>: value' from a script's output."
  [output token]
  (some #(when (str/starts-with? % (str token ": "))
           (str/trim (subs % (inc (count (str token ":"))))))
        (str/split-lines output)))

(defn- roles-rows []
  (let [file (fs/path state-dir "roles.tsv")]
    (if (fs/exists? file)
      (vec (for [line (str/split-lines (slurp (str file)))
                 :when (not (str/blank? line))]
             (str/split line #"\t" -1)))
      [])))

(defn- write-roles-rows! [rows]
  (fs/create-dirs state-dir)
  (spit (str (fs/path state-dir "roles.tsv"))
        (str/join "" (map #(str (str/join "\t" %) "\n") rows))))

(defn- role-row [role worktree-name worktree-path agent-name kind]
  [role worktree-name worktree-path agent-name role kind "task"])

(defn- prepare-worktree! [name path]
  (when-not (fs/exists? (fs/path path ".git"))
    (sh-ok "git" "-C" (str project-root) "worktree" "add" "--force"
           "-B" (str "swarm-worker-" name) path "HEAD"))
  (doseq [sub [["outbox" "tmp"] ["sent"] ["failed"]
               ["inbox" "new"] ["inbox" "in_process"] ["inbox" "completed"]]]
    (fs/create-dirs (apply fs/path path ".swarmforge" "handoffs" sub)))
  (let [target (fs/path path "swarmforge" "scripts")]
    (when-not (= (str target) (str scripts-src))
      (fs/create-dirs target)
      (doseq [script (fs/list-dir scripts-src)]
        (fs/copy script (fs/path target (fs/file-name script))
                 {:replace-existing true :copy-attributes true})))))

(def leader-name "squad-leader")

(defn squad-up! [kind-arg]
  (when-not (fs/exists? (fs/path project-root ".git"))
    (die "Run swarm from the root of a git repository."))
  (when (and (daemon-running? handoffd-daemon)
             (seq (roles-rows))
             (not-any? #(= leader-name (first %)) (roles-rows)))
    (die "A pack swarm is active in this project; run `swarm down` first."))
  (let [kind (or kind-arg "claude")
        prompts (fs/path tool-root "prompts")
        agent-name (project-agent-name leader-name)]
    (install! (fs/path prompts "worker-common.prompt")
              (fs/path project-root "swarmforge" "worker-common.prompt"))
    (install! (fs/path prompts "roles" "squad-leader.prompt")
              (fs/path project-root "swarmforge" "roles" "squad-leader.prompt"))
    (ensure-gitignore!)
    (prepare-worktree! leader-name (str project-root))
    ;; leader row plus any surviving worker rows from a previous session
    (write-roles-rows! (into [(role-row leader-name "master" (str project-root) agent-name kind)]
                             (remove #(= leader-name (first %)) (roles-rows))))
    (let [workspace-id (or (existing-workspace)
                           (let [ws (herdr "workspace" "create"
                                           "--cwd" (str project-root)
                                           "--label" (str "squad:" (fs/file-name project-root))
                                           "--no-focus")
                                 id (find-id ws "workspace")]
                             (spit (str (fs/path state-dir "herdr-workspace")) (str id "\n"))
                             id))]
      (if ((existing-agents) agent-name)
        (println "squad-leader already running.")
        (let [tab (herdr "tab" "create" "--workspace" workspace-id
                         "--cwd" (str project-root) "--label" leader-name
                         "--env" (str "SWARMFORGE_ROLE=" leader-name) "--no-focus")
              pane-id (find-id tab "pane")
              start (herdr-try "agent" "start" agent-name "--kind" kind "--pane" pane-id)]
          (if (:ok? start)
            (herdr "agent" "prompt" agent-name
                   (str "You are the squad-leader. Read swarmforge/roles/squad-leader.prompt "
                        "and follow it exactly. Your project root is " project-root ". "
                        "Check the queue now with swarmforge/scripts/ready_for_next.sh, then "
                        "report to the user that the squad is ready and wait for direction."))
            (println "squad-leader started but BLOCKED (startup dialog); answer it, then `swarm bootstrap squad-leader` equivalent: rerun `swarm squad up`."))
          (slog! "squad-up: leader started as" agent-name))))
    (start-daemon! handoffd-daemon)
    (start-daemon! squadd-daemon)
    (println)
    (println "Squad is up. Talk to the squad-leader pane, or seed it with:")
    (println "  herdr agent prompt" (project-agent-name leader-name) "\"<your request>\"")))

(defn squad-spawn! [assignment-id template no-agent?]
  (when (or (str/blank? assignment-id) (str/blank? template))
    (die "Usage: swarm squad spawn <assignment-id> <template> [--no-agent]"))
  ;; cross-registry validation: the assignment must exist and be spawnable
  (let [status-out (squad-script "squad_assign" "status" assignment-id)
        state (script-token status-out "STATE")]
    (when-not (= "created" state)
      (die (str "Assignment " assignment-id " is '" state "', not 'created'; cannot spawn."))))
  (let [alloc (squad-script "squad_worker" "allocate" assignment-id template)
        worker (or (script-token alloc "WORKER_ALLOCATED")
                   (die "squad_worker allocate returned no worker name:" alloc))
        path (str (fs/path worktrees-dir worker))]
    (prepare-worktree! worker path)
    (write-roles-rows! (conj (roles-rows) (role-row worker worker path worker "claude")))
    (when-not no-agent?
      (let [workspace-id (or (existing-workspace) (die "No squad workspace; run `swarm squad up` first."))
            tab (herdr "tab" "create" "--workspace" workspace-id
                       "--cwd" path "--label" worker
                       "--env" (str "SWARMFORGE_ROLE=" worker) "--no-focus")
            pane-id (find-id tab "pane")]
        (fs/create-dirs (fs/path state-dir "squad" "herdr"))
        (spit (str (fs/path state-dir "squad" "herdr" (str worker ".edn")))
              (pr-str {:tab-id (find-id tab "tab") :pane-id pane-id}))
        (herdr "agent" "start" worker "--kind" "claude" "--pane" pane-id)
        (herdr "agent" "prompt" worker
               (str "You are transient squad worker '" worker "' (template: " template "). "
                    "Read swarmforge/worker-common.prompt"
                    (when (fs/exists? (fs/path project-root "swarmforge" "roles" (str template ".prompt")))
                      (str " and swarmforge/roles/" template ".prompt"))
                    " and obey them. Your worktree is " path ". "
                    "YOUR ASSIGNMENT (id " assignment-id "):\n\n"
                    (slurp (str (fs/path state-dir "squad" "assignments" assignment-id "assignment.md")))
                    "\n\nWhen fully complete: commit, send a git_handoff to squad-leader "
                    "with task '" assignment-id "' via swarmforge/scripts/swarm_handoff.sh, "
                    "then run swarmforge/scripts/done_with_current.sh."))))
    (squad-script "squad_worker" "activate" worker)
    (squad-script "squad_assign" "spawn" assignment-id)
    (slog! "squad: spawned" worker "for" assignment-id (str "(" template ")"))
    (println "WORKER_SPAWNED:" worker)))

(defn squad-retire! [worker reason no-agent?]
  (when (str/blank? worker)
    (die "Usage: swarm squad retire <worker-name> [reason...]"))
  (apply squad-script "squad_worker" "retire" worker
         (when-not (str/blank? reason) [reason]))
  (write-roles-rows! (vec (remove #(= worker (first %)) (roles-rows))))
  (when-not no-agent?
    (let [sidecar (fs/path state-dir "squad" "herdr" (str worker ".edn"))]
      (when (fs/exists? sidecar)
        (let [{:keys [tab-id]} (edn/read-string (slurp (str sidecar)))]
          (herdr-try "tab" "close" tab-id))
        (fs/delete sidecar))))
  (let [path (fs/path worktrees-dir worker)]
    (when (fs/exists? path)
      (process/sh {:continue true} "git" "-C" (str project-root)
                  "worktree" "remove" "--force" (str path))))
  (slog! "squad: retired" worker)
  (println "WORKER_RETIRED:" worker))

(defn squad-report!
  "Readable squad history: assignments with states and commits,
  approvals, and the tail of the event timeline. With a theme id,
  scoped to its attached assignments."
  [theme-id]
  (let [squad (fs/path state-dir "squad")
        theme-assignments (when theme-id
                            (let [status (fs/path squad "themes" theme-id "status.edn")]
                              (when-not (fs/exists? status)
                                (die (str "No such theme: " theme-id)))
                              (set (:assignments (edn/read-string (slurp (str status)))))))
        include? (fn [id] (or (nil? theme-assignments) (theme-assignments id)))]
    (println (str "# Squad report" (when theme-id (str " — theme " theme-id))))
    (println)
    (println "## Assignments")
    (doseq [dir (when (fs/exists? (fs/path squad "assignments"))
                  (sort-by fs/file-name (fs/list-dir (fs/path squad "assignments"))))
            :let [id (fs/file-name dir)
                  status-file (fs/path dir "status.edn")]
            :when (and (include? id) (fs/exists? status-file))
            :let [{:keys [state template updated-at]} (edn/read-string (slurp (str status-file)))]]
      (println (format "- %-24s %-14s %-12s %s" id (name state) template (or updated-at ""))))
    (println)
    (println "## Approvals")
    (let [approvals-dir (fs/path squad "approvals")]
      (if (fs/exists? approvals-dir)
        (doseq [f (sort-by fs/file-name (fs/list-dir approvals-dir))
                :let [{:keys [id state gate target title]} (edn/read-string (slurp (str f)))]
                :when (include? target)]
          (println (format "- %-16s %-9s gate=%-8s target=%-20s %s" id (name state) gate target title)))
        (println "- none")))
    (println)
    (println "## Recent events")
    (let [events (fs/path squad "events.log")]
      (doseq [line (take-last 15 (if (fs/exists? events)
                                   (str/split-lines (slurp (str events))) []))
              :when (or (nil? theme-assignments)
                        (some #(str/includes? line %) theme-assignments))]
        (println " " line)))))

(defn squad! [args]
  (let [flags (set (filter #(str/starts-with? % "--") args))
        args (vec (remove #(str/starts-with? % "--") args))
        no-agent? (contains? flags "--no-agent")]
    (case (first args)
      "up" (squad-up! (second args))
      "spawn" (squad-spawn! (second args) (nth args 2 nil) no-agent?)
      "retire" (squad-retire! (second args) (str/join " " (drop 2 args)) no-agent?)
      "status" (print (squad-script "squad_worker" "list"))
      "approvals" (print (squad-script "squad_approval" "list"))
      "approve" (print (apply squad-script "squad_approval" "approve" (rest args)))
      "deny" (print (apply squad-script "squad_approval" "reject" (rest args)))
      "report" (squad-report! (second args))
      (die "Usage: swarm squad [up [kind] | spawn <id> <template> | retire <worker> [reason] | status | approvals | approve <id> [detail] | deny <id> <reason> | report [theme]]"))))

(defn -main [args]
  (case (first args)
    "init" (init! (second args))
    "switch" (switch! (second args))
    "toolset" (toolset! (second args))
    "up" (up!)
    nil (up!)
    "bootstrap" (bootstrap! (second args))
    "down" (down!)
    "retire" (retire!)
    "status" (status!)
    "logs" (logs! (second args))
    "prompt" (prompt! (second args) (str/join " " (drop 2 args)))
    "squad" (squad! (vec (rest args)))
    (die (str "Unknown subcommand: " (first args))
         "Usage: swarm [init <pack> | switch <pack> | toolset <name> | up | bootstrap [role] | prompt <role> <text> | squad <cmd> | down | retire | status | logs [n]]")))

(-main *command-line-args*)
